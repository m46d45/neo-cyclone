# Optional: enables cloud AI drafting of CYCLONE models (xAI / Grok API).
# Without this key the app still works using the local prompt → model builder.
XAI_API_KEY=

# Optional auth (leave unset for open studio with PGLite fallback)
# Optional: Neon Postgres. Required for a durable *global* usage counter
# (simulations / models drawn across all visitors). Without it, the studio
# still works; the footer only shows counts for this device.
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-app.vercel.app
